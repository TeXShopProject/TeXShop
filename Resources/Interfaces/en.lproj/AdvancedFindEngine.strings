/* Messages of the Advanced Find engine (Sources/Find), shown by the find panel and the multiple replacement window. */

/* A plain-text or regular expression find string has nothing to find. */
"The find string is empty." = "The find string is empty.";

/* Searching in the selection while nothing is selected. */
"There is no selection to search in." = "There is no selection to search in.";

/* A multiple replacement definition (CotEditor .cotrpl) lacks its rules or its settings. */
"The replacement definition has no replacements or settings." = "The replacement definition has no replacements or settings.";

/* A rule of a multiple replacement definition is not valid. */
"A replacement of the definition is not valid." = "A replacement of the definition is not valid.";

/* The settings of a multiple replacement definition are not valid. */
"The settings of the replacement definition are not valid." = "The settings of the replacement definition are not valid.";

/* Cheat sheet, differences from OgreKit: \d, \w, \s and \b have their Unicode meaning in ICU. */
"Unicode: also full-width digits, kanji, kana and the full-width space." = "Unicode: also full-width digits, kanji, kana and the full-width space.";

/* Cheat sheet, differences from OgreKit. “Always capture” is an option of the OgreKit find panel. */
"Named groups are numbered too, as with OgreKit's “Always capture” on." = "Named groups are numbered too, as with OgreKit's “Always capture” on.";

/* Cheat sheet and find field, differences from OgreKit: a brace by itself is an error in ICU. */
"ICU needs \\{ and \\} for literal braces (OgreKit did not)." = "ICU needs \\{ and \\} for literal braces (OgreKit did not).";

/* Cheat sheet and find field, differences from OgreKit. */
"In ICU \\h is a horizontal space; in OgreKit it was a hexadecimal digit. For a digit, write [0-9a-fA-F]." = "In ICU \\h is a horizontal space; in OgreKit it was a hexadecimal digit. For a digit, write [0-9a-fA-F].";

/* Cheat sheet and find field, differences from OgreKit. */
"In ICU (?m) makes ^ and $ match at each line; in OgreKit it made . match line breaks, which is (?s) in ICU." = "In ICU (?m) makes ^ and $ match at each line; in OgreKit it made . match line breaks, which is (?s) in ICU.";

/* Cheat sheet and find field, differences from OgreKit. */
"In ICU {n}+ is possessive; in OgreKit it repeated the repetition." = "In ICU {n}+ is possessive; in OgreKit it repeated the repetition.";

/* Cheat sheet and find field, differences from OgreKit. */
"ICU has no \\K. Write the part before it as a look-behind (?<=…)." = "ICU has no \\K. Write the part before it as a look-behind (?<=…).";

/* Cheat sheet and find field, differences from OgreKit. */
"ICU cannot call a group with \\g<name>. Repeat the group's pattern instead." = "ICU cannot call a group with \\g<name>. Repeat the group's pattern instead.";

/* Cheat sheet and find field, differences from OgreKit. */
"ICU has no absent operator (?~…)." = "ICU has no absent operator (?~…).";

/* Cheat sheet, differences from OgreKit: OgreKit's \p{^…} is an error in ICU. */
"Write \\P{…} in ICU." = "Write \\P{…} in ICU.";
