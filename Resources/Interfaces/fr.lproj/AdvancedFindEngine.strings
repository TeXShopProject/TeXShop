/* Messages of the Advanced Find engine (Sources/Find), shown by the find panel and the multiple replacement window. */

/* A plain-text or regular expression find string has nothing to find. */
"The find string is empty." = "Le texte à rechercher est vide.";

/* Searching in the selection while nothing is selected. */
"There is no selection to search in." = "Il n’y a aucune sélection dans laquelle rechercher.";

/* A multiple replacement definition (CotEditor .cotrpl) lacks its rules or its settings. */
"The replacement definition has no replacements or settings." = "La définition de remplacement ne contient ni règles ni réglages.";

/* A rule of a multiple replacement definition is not valid. */
"A replacement of the definition is not valid." = "La définition de remplacement contient une règle non valide.";

/* The settings of a multiple replacement definition are not valid. */
"The settings of the replacement definition are not valid." = "Les réglages de la définition de remplacement ne sont pas valides.";

