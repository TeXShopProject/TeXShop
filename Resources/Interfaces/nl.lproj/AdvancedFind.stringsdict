<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>TeXRootSearch.Confirm.Disk</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@f@ U kunt deze actie niet ongedaan maken.</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%lu bestand dat niet geopend is, wordt direct op de schijf gewijzigd.</string>
			<key>other</key>
			<string>%lu bestanden die niet geopend zijn, worden direct op de schijf gewijzigd.</string>
		</dict>
	</dict>
	<key>TeXRootSearch.Confirm.Title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@m@ in %2$#@f@ vervangen?</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%2$lu bestand</string>
			<key>other</key>
			<string>%2$lu bestanden</string>
		</dict>
		<key>m</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%1$lu overeenkomst</string>
			<key>other</key>
			<string>%1$lu overeenkomsten</string>
		</dict>
	</dict>
	<key>TeXRootSearch.Status.Replaced</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@m@ in %2$#@f@ vervangen</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%2$lu bestand</string>
			<key>other</key>
			<string>%2$lu bestanden</string>
		</dict>
		<key>m</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%1$lu overeenkomst</string>
			<key>other</key>
			<string>%1$lu overeenkomsten</string>
		</dict>
	</dict>
</dict>
</plist>
