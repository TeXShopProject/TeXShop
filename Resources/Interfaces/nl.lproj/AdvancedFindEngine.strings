/* Messages of the Advanced Find engine (Sources/Find), shown by the find panel and the multiple replacement window. */

/* A plain-text or regular expression find string has nothing to find. */
"The find string is empty." = "De zoektekst is leeg.";

/* Searching in the selection while nothing is selected. */
"There is no selection to search in." = "Er is geen selectie om in te zoeken.";

/* A multiple replacement definition (CotEditor .cotrpl) lacks its rules or its settings. */
"The replacement definition has no replacements or settings." = "De vervangingsdefinitie bevat geen regels of instellingen.";

/* A rule of a multiple replacement definition is not valid. */
"A replacement of the definition is not valid." = "De vervangingsdefinitie bevat een ongeldige regel.";

/* The settings of a multiple replacement definition are not valid. */
"The settings of the replacement definition are not valid." = "De instellingen van de vervangingsdefinitie zijn ongeldig.";

