	<key>TeXRootSearch.Status.Replaced</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@m@ in %2$#@f@</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
