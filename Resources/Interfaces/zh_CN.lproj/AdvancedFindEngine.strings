/* Messages of the Advanced Find engine (Sources/Find), shown by the find panel and the multiple replacement window. */

/* A plain-text or regular expression find string has nothing to find. */
"The find string is empty." = "查找文本为空。";

/* Searching in the selection while nothing is selected. */
"There is no selection to search in." = "没有可在其中查找的所选内容。";

/* A multiple replacement definition (CotEditor .cotrpl) lacks its rules or its settings. */
"The replacement definition has no replacements or settings." = "替换定义中没有规则或设置。";

/* A rule of a multiple replacement definition is not valid. */
"A replacement of the definition is not valid." = "替换定义中有无效的规则。";

/* The settings of a multiple replacement definition are not valid. */
"The settings of the replacement definition are not valid." = "替换定义的设置无效。";

/* Cheat sheet, differences from OgreKit: \d, \w, \s and \b have their Unicode meaning in ICU. */
"Unicode: also full-width digits, kanji, kana and the full-width space." = "按Unicode匹配：也匹配全角数字、汉字、假名和全角空格。";

/* Cheat sheet, differences from OgreKit. “Always capture” is an option of the OgreKit find panel. */
"Named groups are numbered too, as with OgreKit's “Always capture” on." = "命名分组也会编号（与OgreKit中开启“始终捕获”时相同）。";

/* Cheat sheet and find field, differences from OgreKit: a brace by itself is an error in ICU. */
"ICU needs \\{ and \\} for literal braces (OgreKit did not)." = "ICU中的字面花括号需写成 \\{ 和 \\}（OgreKit中不需要）。";

/* Cheat sheet and find field, differences from OgreKit. */
"In ICU \\h is a horizontal space; in OgreKit it was a hexadecimal digit. For a digit, write [0-9a-fA-F]." = "ICU中的 \\h 是水平空白（在OgreKit中是十六进制数字）。如需数字，请写成 [0-9a-fA-F]。";

/* Cheat sheet and find field, differences from OgreKit. */
"In ICU (?m) makes ^ and $ match at each line; OgreKit’s (?m), where . matches line breaks, is (?s)." = "ICU中的 (?m) 使 ^ 和 $ 匹配每一行（在OgreKit中它使 . 匹配换行符，在ICU中即 (?s)）。";

/* Cheat sheet and find field, differences from OgreKit. */
"In ICU {n}+ is possessive; in OgreKit it repeated the repetition." = "ICU中的 {n}+ 是占有量词（在OgreKit中是对重复再重复）。";

/* Cheat sheet and find field, differences from OgreKit. */
"ICU has no \\K. Write the part before it as a look-behind (?<=…)." = "ICU没有 \\K。请将其前面的部分写成后行断言 (?<=…)。";

/* Cheat sheet and find field, differences from OgreKit. */
"ICU cannot call a group with \\g<name>. Repeat the group's pattern instead." = "ICU无法用 \\g<名称> 调用分组。请改为重写该分组的模式。";

/* Cheat sheet and find field, differences from OgreKit. */
"ICU has no absent operator (?~…)." = "ICU不支持排除运算符 (?~…)。";

/* Cheat sheet, differences from OgreKit: OgreKit's \p{^…} is an error in ICU. */
"Write \\P{…} in ICU." = "在ICU中请写成 \\P{…}。";
