<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>TeXRootSearch.Confirm.Disk</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@f@ Não é possível desfazer esta ação.</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%lu arquivo que não está aberto será alterado diretamente no disco.</string>
			<key>other</key>
			<string>%lu arquivos que não estão abertos serão alterados diretamente no disco.</string>
		</dict>
	</dict>
	<key>TeXRootSearch.Confirm.Title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Substituir %1$#@m@ em %2$#@f@?</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%2$lu arquivo</string>
			<key>other</key>
			<string>%2$lu arquivos</string>
		</dict>
		<key>m</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%1$lu ocorrência</string>
			<key>other</key>
			<string>%1$lu ocorrências</string>
		</dict>
	</dict>
	<key>TeXRootSearch.Status.Replaced</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@m@ em %2$#@f@</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%2$lu arquivo</string>
			<key>other</key>
			<string>%2$lu arquivos</string>
		</dict>
		<key>m</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%1$lu ocorrência substituída</string>
			<key>other</key>
			<string>%1$lu ocorrências substituídas</string>
		</dict>
	</dict>
</dict>
</plist>
