/* Messages of the Advanced Find engine (Sources/Find), shown by the find panel and the multiple replacement window. */

/* A plain-text or regular expression find string has nothing to find. */
"The find string is empty." = "O texto de busca está vazio.";

/* Searching in the selection while nothing is selected. */
"There is no selection to search in." = "Não há nenhuma seleção na qual buscar.";

/* A multiple replacement definition (CotEditor .cotrpl) lacks its rules or its settings. */
"The replacement definition has no replacements or settings." = "O conjunto de substituições não contém regras nem ajustes.";

/* A rule of a multiple replacement definition is not valid. */
"A replacement of the definition is not valid." = "O conjunto de substituições contém uma regra inválida.";

/* The settings of a multiple replacement definition are not valid. */
"The settings of the replacement definition are not valid." = "Os ajustes do conjunto de substituições são inválidos.";

