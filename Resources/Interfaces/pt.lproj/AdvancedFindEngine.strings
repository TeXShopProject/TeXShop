/* Messages of the Advanced Find engine (Sources/Find), shown by the find panel and the multiple replacement window. */

/* A plain-text or regular expression find string has nothing to find. */
"The find string is empty." = "O texto de busca está vazio.";

/* Searching in the selection while nothing is selected. */
"There is no selection to search in." = "Não há nenhuma seleção na qual buscar.";

/* A multiple replacement definition (CotEditor .cotrpl) lacks its rules or its settings. */
"The replacement definition has no replacements or settings." = "O conjunto de substituições não contém regras nem ajustes.";

/* A rule of a multiple replacement definition is not valid. */
"A replacement of the definition is not valid." = "O conjunto de substituições contém uma regra inválida.";

/* The settings of a multiple replacement definition are not valid. */
"The settings of the replacement definition are not valid." = "Os ajustes do conjunto de substituições são inválidos.";

/* Cheat sheet, differences from OgreKit: \d, \w, \s and \b have their Unicode meaning in ICU. */
"Unicode: also full-width digits, kanji, kana and the full-width space." = "Unicode: inclui dígitos de largura total, kanji, kana e o espaço de largura total.";

/* Cheat sheet, differences from OgreKit. “Always capture” is an option of the OgreKit find panel. */
"Named groups are numbered too, as with OgreKit's “Always capture” on." = "Grupos com nome também são numerados, como com “Sempre capturar” ativado no OgreKit.";

/* Cheat sheet and find field, differences from OgreKit: a brace by itself is an error in ICU. */
"ICU needs \\{ and \\} for literal braces (OgreKit did not)." = "O ICU exige \\{ e \\} para chaves literais (o OgreKit não).";

/* Cheat sheet and find field, differences from OgreKit. */
"In ICU \\h is a horizontal space; in OgreKit it was a hexadecimal digit. For a digit, write [0-9a-fA-F]." = "No ICU, \\h é espaço horizontal (no OgreKit, dígito hexadecimal). Use [0-9a-fA-F].";

/* Cheat sheet and find field, differences from OgreKit. */
"In ICU (?m) makes ^ and $ match at each line; in OgreKit it made . match line breaks, which is (?s) in ICU." = "ICU: (?m) aplica ^ e $ a cada linha. O (?m) do OgreKit (. com quebras de linha) é (?s) no ICU.";

/* Cheat sheet and find field, differences from OgreKit. */
"In ICU {n}+ is possessive; in OgreKit it repeated the repetition." = "No ICU, {n}+ é possessivo; no OgreKit, repetia a repetição.";

/* Cheat sheet and find field, differences from OgreKit. */
"ICU has no \\K. Write the part before it as a look-behind (?<=…)." = "O ICU não tem \\K. Escreva a parte anterior como lookbehind (?<=…).";

/* Cheat sheet and find field, differences from OgreKit. */
"ICU cannot call a group with \\g<name>. Repeat the group's pattern instead." = "O ICU não chama grupos com \\g<nome>. Repita o padrão do grupo.";

/* Cheat sheet and find field, differences from OgreKit. */
"ICU has no absent operator (?~…)." = "O ICU não tem o operador de ausência (?~…).";

/* Cheat sheet, differences from OgreKit: OgreKit's \p{^…} is an error in ICU. */
"Write \\P{…} in ICU." = "No ICU, escreva \\P{…}.";
