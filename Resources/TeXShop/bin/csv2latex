#!/bin/sh
# csv2latex: turns spreadsheet cells on the clipboard into a LaTeX table on the clipboard.
# Used by the macro Paste Spreadsheet Cells.
# After csv2latex 1.2 (Ruby) by Tom Counsell (2005) and Alan Munn (2009, 2010), licensed under
# the GPL; rewritten for texlua (TeX Live) in TeXShop 6.00.
#
# csv2latex [tablestyle]
#
# tablestyle is cells, simple (the default), booktabs or longtable. Copy the cells in the
# spreadsheet, run this, and paste. The work is done by csv2latex.lua in this folder, run by
# texlua of TeX Live. When the clipboard has no text, the clipboard is left as it is.

# TeX Live as set in TeXShop's Settings (Typesetting > Paths > TeX Engines), then the usual places.
bin=$(/usr/bin/defaults read TeXShop TetexBinPath 2>/dev/null)
case $bin in
"~"*) bin=$HOME${bin#\~} ;;
esac
PATH="${bin:+$bin:}$PATH:/Library/TeX/texbin:/usr/texbin:/usr/local/bin"
export PATH

if ! command -v texlua >/dev/null 2>&1; then
    echo "csv2latex: texlua of TeX Live is not found; check Settings > Typesetting > Paths > TeX Engines in TeXShop" >&2
    exit 1
fi

# The clipboard is read and written as UTF-8, so that every character comes back as it was.
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
export LANG LC_ALL

table=$(/usr/bin/mktemp "${TMPDIR:-/tmp}/csv2latex.XXXXXX") || exit 1
trap '/bin/rm -f "$table"' EXIT
pbpaste | texlua "$(dirname "$0")/csv2latex.lua" "$@" > "$table" || exit 1
# Nothing is written when there are no rows; the clipboard then stays as it is.
[ -s "$table" ] || exit 0
pbcopy < "$table" || exit 1
echo "Ok. In clipboard"
