#!/bin/sh
# pdfselectc
# Claus Gerhardt; rewritten for texlua (TeX Live) in TeXShop 6.00
#
# pdfselectc selection1 [selection2 ...] filename
#
# filename is the PDF without the suffix .pdf. For each selection, such as 5:8 or 3:4,6,8:12,
# the PDF filename-i.pdf is made with those pages, where i is the number of the selection.
# The work is done by pdfselectc.lua in this folder, run by texlua of TeX Live.

# TeX Live as set in TeXShop's Settings (Typesetting > Paths > TeX Engines), then the usual places.
bin=$(/usr/bin/defaults read TeXShop TetexBinPath 2>/dev/null)
case $bin in
"~"*) bin=$HOME${bin#\~} ;;
esac
PATH="${bin:+$bin:}$PATH:/Library/TeX/texbin:/usr/texbin:/usr/local/bin"
export PATH

if ! command -v texlua >/dev/null 2>&1; then
    echo "pdfselectc: texlua of TeX Live is not found; check Settings > Typesetting > Paths > TeX Engines in TeXShop" >&2
    exit 1
fi
exec texlua "$(dirname "$0")/pdfselectc.lua" "$@"
